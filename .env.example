# Salin ke .env.local untuk pengembangan lokal. Jangan commit file .env apa pun.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Email satu-satunya pengguna yang boleh login
OWNER_EMAIL=
# Kunci dan nama model Gemini untuk Ra (lihat docs/DECISIONS.md D-38). Tanpa ini Ra memakai pengurai lokal.
GEMINI_API_KEY=
GEMINI_MODEL=
# Hanya untuk uji e2e dengan server Gemini tiruan. Kosongkan di production.
# GEMINI_BASE_URL=
GEMINI_LIVE_MODEL=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
CRON_SECRET=
APP_TIMEZONE=Asia/Jakarta
